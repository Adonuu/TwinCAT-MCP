{
  "mcpServers": {
    "twincat": {
      "command": "dnx",
      "args": [
        "Adonuu.TwinCatMcp@0.1.0",
        "--yes"
      ],
      "env": {
        "Runtime__AmsNetId": "127.0.0.1.1.1",
        "Runtime__AmsPort": "851",
        "Automation__ShowIde": "false",
        "Safety__SafeMode": "true",
        "Safety__AuditLogPath": "twincat-mcp-audit.jsonl"
      }
    }
  }
}
